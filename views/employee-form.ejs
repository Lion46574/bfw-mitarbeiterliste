<%- include("partials/header") %>

<section class="card">
  <h2><%= employee ? "Mitarbeiter bearbeiten" : "Mitarbeiter eintragen" %></h2>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form
    method="post"
    action="<%= employee ? `/employees/${employee.id}/edit` : '/employees' %>"
    class="form-grid"
  >
    <label for="first_name">Vorname</label>
    <input id="first_name" name="first_name" value="<%= employee?.first_name || '' %>" required />

    <label for="last_name">Nachname</label>
    <input id="last_name" name="last_name" value="<%= employee?.last_name || '' %>" required />

    <label for="department">Abteilung</label>
    <select id="department" name="department">
      <option value="">Optional: keine Abteilung</option>
      <% (departments || []).forEach((dep) => { %>
        <option value="<%= dep.name %>" <%= (employee?.department || '') === dep.name ? 'selected' : '' %>>
          <%= dep.name %>
        </option>
      <% }) %>
    </select>

    <label>Dienstgrade (Mehrfachauswahl)</label>
    <div class="options-list">
      <% (positions || []).forEach((pos) => { %>
        <label class="option-item">
          <input
            type="checkbox"
            name="position_ids[]"
            value="<%= pos.id %>"
            <%= (selectedPositionIds || []).includes(pos.id) ? 'checked' : '' %>
          />
          <span><%= pos.name %></span>
        </label>
      <% }) %>
    </div>

    <button type="submit">Speichern</button>
  </form>
</section>

<%- include("partials/footer") %>
