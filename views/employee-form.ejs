<%- include("partials/header") %>

<section class="card">
  <h2><%= employee ? "Mitarbeiter bearbeiten" : "Mitarbeiter eintragen" %></h2>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form
    method="post"
    action="<%= employee ? `/employees/${employee.id}/edit` : '/employees' %>"
    class="form-grid"
  >
    <label for="first_name">Vorname</label>
    <input id="first_name" name="first_name" value="<%= employee?.first_name || '' %>" required />

    <label for="last_name">Nachname</label>
    <input id="last_name" name="last_name" value="<%= employee?.last_name || '' %>" required />

    <label for="department">Abteilung</label>
    <select id="department" name="department">
      <option value="">Optional: keine Abteilung</option>
      <% (typeof departments !== 'undefined' && Array.isArray(departments) ? departments : []).forEach((dep) => { %>
        <% const depName = typeof dep === 'string' ? dep : dep.name; %>
        <option value="<%= depName %>" <%= (employee?.department || '') === depName ? 'selected' : '' %>>
          <%= depName %>
        </option>
      <% }) %>
    </select>

    <label>Dienstgrade (Mehrfachauswahl)</label>
    <div class="options-list">
      <% (typeof positions !== 'undefined' && Array.isArray(positions) ? positions : []).forEach((pos) => { %>
        <% const posId = typeof pos === 'number' ? pos : pos.id; %>
        <% const posName = typeof pos === 'string' ? pos : pos.name; %>
        <label class="option-item">
          <input
            type="checkbox"
            name="position_ids[]"
            value="<%= posId %>"
            <%= ((typeof selectedPositionIds !== 'undefined' && Array.isArray(selectedPositionIds)) ? selectedPositionIds : []).includes(posId) ? 'checked' : '' %>
          />
          <span><%= posName %></span>
        </label>
      <% }) %>
    </div>

    <label>Funktionen (Mehrfachauswahl)</label>
    <div class="options-list">
      <% (typeof functionsCatalog !== 'undefined' && Array.isArray(functionsCatalog) ? functionsCatalog : []).forEach((item) => { %>
        <label class="option-item">
          <input
            type="checkbox"
            name="function_ids[]"
            value="<%= item.id %>"
            <%= ((typeof selectedFunctionIds !== 'undefined' && Array.isArray(selectedFunctionIds)) ? selectedFunctionIds : []).includes(item.id) ? 'checked' : '' %>
          />
          <span><%= item.name %></span>
        </label>
      <% }) %>
    </div>

    <label>Ausbildungen (Mehrfachauswahl)</label>
    <div class="options-list">
      <% (typeof trainingsCatalog !== 'undefined' && Array.isArray(trainingsCatalog) ? trainingsCatalog : []).forEach((item) => { %>
        <label class="option-item">
          <input
            type="checkbox"
            name="training_ids[]"
            value="<%= item.id %>"
            <%= ((typeof selectedTrainingIds !== 'undefined' && Array.isArray(selectedTrainingIds)) ? selectedTrainingIds : []).includes(item.id) ? 'checked' : '' %>
          />
          <span><%= item.name %></span>
        </label>
      <% }) %>
    </div>

    <button type="submit">Speichern</button>
  </form>
</section>

<%- include("partials/footer") %>
