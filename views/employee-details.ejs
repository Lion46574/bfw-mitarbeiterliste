<%- include("partials/header") %>

<section class="card">
  <h2>Details: <%= employee.first_name %> <%= employee.last_name %></h2>
  <p><strong>Abteilung:</strong> <%= employee.department || "-" %></p>
  <p><strong>Erstellt von:</strong> <%= employee.creator %></p>
  <p><a href="/" class="button-link">Zurueck zur Liste</a></p>
</section>

<section class="card">
  <h3>Information</h3>
  <table>
    <thead>
      <tr>
        <th>Referat</th>
        <th>Ausbildung</th>
      </tr>
    </thead>
    <tbody>
      <% const maxRows = Math.max(funktionen.length, ausbildungen.length); %>
      <% if (!maxRows) { %>
        <tr>
          <td colspan="2">Keine Eintraege vorhanden.</td>
        </tr>
      <% } %>

      <% for (let i = 0; i < maxRows; i += 1) { %>
        <tr>
          <td><%= funktionen[i] || "-" %></td>
          <td><%= ausbildungen[i] || "-" %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include("partials/footer") %>
