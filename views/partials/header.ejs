<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BF Wien Mitarbeiterliste</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <h1>BF Wien Mitarbeiterliste</h1>
    <nav>
      <a href="/">Start</a>
      <% if (user) { %>
        <a href="/employees/new">Mitarbeiter eintragen</a>
        <a href="/account/password">Passwort aendern</a>
        <% if (user.role === "admin") { %>
          <a href="/admin/users">Konten verwalten</a>
        <% } %>
        <form action="/logout" method="post" class="inline-form">
          <button type="submit">Logout (<%= user.username %>)</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
